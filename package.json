{
  "name": "ciderlabs",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm run content:sync && astro dev",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && pnpm run content:sync && astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "astro": "astro",
    "check": "biome check --write",
    "content:sync": "node --env-file-if-exists=.env --import tsx scripts/prepare.ts --refresh-reactions",
    "typegen:cms": "microcms-typegen generate",
    "check:cms": "microcms-typegen check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7",
    "cheerio": "^1.2.0",
    "microcms-js-sdk": "^3.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@biomejs/biome": "^2.6.6",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "microcms-typegen": "^1.0.0",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0",
    "zenn-content-css": "^0.5.14",
    "zenn-embed-elements": "^0.5.14",
    "zenn-markdown-html": "^0.5.14"
  }
}
