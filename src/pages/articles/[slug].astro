---
import type { GetStaticPaths } from 'astro';
import 'zenn-content-css/lib/index.css';
import '../../styles/articles.css';
import CopyMarkdownButton from '../../components/CopyMarkdownButton.astro';
import Reactions from '../../components/Reactions';
import ShareButton from '../../components/ShareButton.astro';
import { site } from '../../config/site';
import Base from '../../layouts/Base.astro';
import { getArticleDocuments, getArticles } from '../../lib/articles.server';
import {
  type ArticleDocument,
  cleanExcerpt,
  findRelatedArticles,
  formatDate,
  normalizeTags,
} from '../../lib/content';

export const getStaticPaths = (() =>
  getArticleDocuments().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }))) satisfies GetStaticPaths;

interface Props {
  article: ArticleDocument;
}

const { article } = Astro.props;
const displayTags = normalizeTags(article.tags);
const displayDescription = cleanExcerpt(article.description, 140);
const relatedArticles = findRelatedArticles(getArticles(), {
  slug: article.slug,
  name: article.title,
  tags: article.tags,
});
---

<Base
  title={article.title + ' | ' + site.name}
  description={displayDescription}
  type="article"
  ogImage={`/og/articles/${article.slug}.png`}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={article.date} />

    {article.updatedAt && (
      <meta
        property="article:modified_time"
        content={article.updatedAt}
      />
    )}

    {article.hasEmbeds && (
      <script
        is:inline
        src="https://embed.zenn.studio/js/listen-embed-event.js"
      ></script>
    )}
  </Fragment>

  <div class="shell article-page">
    <article class="article-body">
      <div class="flex flex-wrap items-center gap-5">
        <a class="back-link" href="/articles/">← 記事一覧</a>
        <a class="back-link" href="/#writing">トップページへ</a>
      </div>

      <header class="article-title">
        <div class="tags">
          {displayTags.map(tag => <span>{tag}</span>)}
        </div>

        <h1>{article.title}</h1>

        <p class="article-dates">
          {site.author} · 公開
          <time datetime={article.date}>
            {formatDate(article.date)}
          </time>

          {article.updatedAt && (
            <span>
              · 更新
              <time datetime={article.updatedAt}>
                {formatDate(article.updatedAt)}
              </time>
            </span>
          )}
        </p>

        <p class="lead">{displayDescription}</p>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
          <Reactions article={article} showFetchedAt />
          <div class="flex flex-wrap items-center gap-2">
            <ShareButton title={article.title} text={displayDescription} />
            <CopyMarkdownButton markdown={article.markdown} />
          </div>
        </div>
      </header>

      {article.headings.length > 0 && (
        <details class="mobile-toc">
          <summary>この記事の内容</summary>

          <nav aria-label="記事の目次">
            {article.headings.map(heading => (
              <a
                href={'#' + encodeURIComponent(heading.id)}
                data-level={heading.level}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </details>
      )}

      <div class="znc doc-content" set:html={article.html} />

      {
        relatedArticles.length > 0 && (
          <section class="project-section mt-12">
            <h2>関連する技術記事</h2>
            <div class="mt-4 grid gap-3">
              {relatedArticles.map(related => (
                <a class="related-article-card" href={related.url}>
                  <div>
                    <time datetime={related.date}>
                      {formatDate(related.date)}
                    </time>
                    <strong>{related.title}</strong>
                  </div>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <footer class="article-end">
        <p>この記事へのリアクション・コメントは各掲載先へ。</p>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <Reactions article={article} showFetchedAt />
          <ShareButton title={article.title} text={displayDescription} />
        </div>
        <div class="mt-6">
          <a class="text-link" href="/articles/">← すべての技術記事を見る</a>
        </div>
      </footer>
    </article>

    <aside class="desktop-toc">
      {article.headings.length > 0 && (
        <nav aria-label="記事の目次">
          <p class="eyebrow">この記事の内容</p>

          {article.headings.map(heading => (
            <a
              href={'#' + encodeURIComponent(heading.id)}
              data-level={heading.level}
            >
              {heading.text}
            </a>
          ))}
        </nav>
      )}
    </aside>
  </div>

  {
    article.hasMath && (
      <script>
        if (document.querySelector('embed-katex')) {
          import('zenn-embed-elements');
        }
      </script>
    )
  }
</Base>
