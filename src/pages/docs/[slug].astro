---
import type { GetStaticPaths } from 'astro';
import 'zenn-content-css/lib/index.css';

import { site } from '../../config/site';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/cms.server';
import {
  docHref,
  findRelatedArticles,
  formatDate,
  type Library,
} from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown.server';

export const getStaticPaths = (async () => {
  const { libraries } = await getContent();

  return libraries.map((library) => ({
    params: { slug: library.slug },
    props: { library },
  }));
}) satisfies GetStaticPaths;

interface Props {
  library: Library;
}

const { library } = Astro.props;
const { libraries, articles } = await getContent();
const { html, headings, hasEmbeds } = await renderMarkdown(library.markdown);
const otherLibraries = libraries.filter((item) => item.slug !== library.slug);
const relatedArticles = findRelatedArticles(articles, {
  slug: library.slug,
  name: library.name,
  tags: [library.category],
});
---

<Base
  title={`${library.name} の導入ガイド | ${site.name}`}
  description={library.description}
  ogImage={`/og/docs/${library.slug}.png`}
>
  <Fragment slot="head">
    {
      hasEmbeds && (
        <script
          is:inline
          src="https://embed.zenn.studio/js/listen-embed-event.js"
        ></script>
      )
    }
  </Fragment>

  <div class="shell docs-layout">
    <aside class="docs-sidebar">
      <a class="back-link" href="/#libraries">← ライブラリ一覧</a>
      <p class="eyebrow">DOCUMENTATION</p>

      <nav aria-label="ライブラリのドキュメント">
        {
          libraries.map(item => (
            <a
              href={docHref(item.slug)}
              aria-current={item.slug === library.slug ? 'page' : undefined}
            >
              {item.name}
            </a>
          ))
        }
      </nav>
    </aside>

    <article class="docs-article">
      <div class="mb-6 lg:hidden">
        <a class="back-link" href="/#libraries">← ライブラリ一覧へ戻る</a>
      </div>

      <header class="docs-title">
        <p class="eyebrow">{library.category} / 導入ガイド</p>
        <h1>{library.name}</h1>
        <p class="lead">{library.description}</p>

        <div class="card-links">
          <a href={library.repoUrl} target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
          <a href={library.npmUrl} target="_blank" rel="noopener noreferrer">
            npm ↗
          </a>
        </div>

        <div class="install">
          <code>{library.command}</code>
          <button
            type="button"
            class="copy-btn"
            data-copy={library.command}
            aria-label="インストールコマンドをコピー"
          >
            <svg
              class="copy-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <svg
              class="check-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
            <span class="copy-label">コピー</span>
          </button>
        </div>
      </header>

      {
        headings.length > 0 && (
          <details class="mobile-toc">
            <summary>このページの内容</summary>
            <nav aria-label="ページ内の目次">
              {headings.map(heading => (
                <a
                  href={'#' + encodeURIComponent(heading.id)}
                  data-level={heading.level}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </details>
        )
      }

      <div class="znc doc-content" set:html={html} />

      {
        relatedArticles.length > 0 && (
          <section class="project-section mt-12">
            <h2>関連する技術記事</h2>
            <div class="mt-4 grid gap-3">
              {relatedArticles.map(article => (
                <a class="related-article-card" href={article.url}>
                  <div>
                    <time datetime={article.date}>
                      {formatDate(article.date)}
                    </time>
                    <strong>{article.title}</strong>
                  </div>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <footer class="article-end mt-12 border-t border-line pt-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap gap-3">
            <a
              class="button outline"
              href={library.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub README で詳細を見る <span aria-hidden="true">↗</span>
            </a>
            <a
              class="button outline"
              href={library.npmUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              npm パッケージを見る <span aria-hidden="true">↗</span>
            </a>
          </div>

          {
            otherLibraries.map(other => (
              <a class="text-link" href={docHref(other.slug)}>
                {other.name} の導入ガイドを読む →
              </a>
            ))
          }
        </div>
      </footer>
    </article>

    <aside class="desktop-toc">
      {
        headings.length > 0 && (
          <nav aria-label="ページ内の目次">
            <p class="eyebrow">このページの内容</p>
            {headings.map(heading => (
              <a
                href={'#' + encodeURIComponent(heading.id)}
                data-level={heading.level}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        )
      }
    </aside>
  </div>

  <script>
    if (document.querySelector('embed-katex')) {
      import('zenn-embed-elements');
    }
  </script>
</Base>
