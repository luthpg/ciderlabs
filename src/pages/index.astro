---
import ArticleList from '../components/ArticleList';
import { About, Hero, Libraries, Projects } from '../components/HomeSections';
import { site } from '../config/site';
import Base from '../layouts/Base.astro';
import { getContent } from '../lib/cms.server';

const content = await getContent();
---

<Base>
  <Hero counts={content} />
  <Projects projects={content.projects} />

  <section id="writing" class="writing-section">
    <div class="shell section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / WRITING</p>
          <h2>つくりながら、考えたこと。</h2>
        </div>
        <a class="text-link" href={site.zenn}>Zennの記事一覧 ↗</a>
      </div>

      <ArticleList articles={content.articles} client:visible />
    </div>
  </section>

  <Libraries libraries={content.libraries} />
  <About />
</Base>
