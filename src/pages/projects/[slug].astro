---
import type { GetStaticPaths } from 'astro';
import 'zenn-content-css/lib/index.css';
import CopyMarkdownButton from '../../components/CopyMarkdownButton.astro';
import { ProjectVisual } from '../../components/HomeSections';
import { site } from '../../config/site';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/cms.server';
import {
  docHref,
  findRelatedArticles,
  formatDate,
  getValidProjectMarkdown,
  type Project,
  projectDetailHref,
  projectSlug,
} from '../../lib/content';
import {
  renderMarkdown,
  sanitizeMarkdownForCopy,
} from '../../lib/markdown.server';

export const getStaticPaths = (async () => {
  const { projects } = await getContent();

  return projects.map((project) => ({
    params: { slug: projectSlug(project) },
    props: { project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const slug = projectSlug(project);
const { projects, articles } = await getContent();
const validMarkdown = getValidProjectMarkdown(project.markdown);
const rendered = validMarkdown ? await renderMarkdown(validMarkdown) : null;
const copyMarkdown = validMarkdown
  ? sanitizeMarkdownForCopy(validMarkdown, {
      title: project.name,
      description: project.description,
    })
  : '';
const relatedArticles = findRelatedArticles(articles, {
  slug,
  name: project.name,
  tags: project.tags,
});
---

<Base
  title={`${project.name} | ${site.name}`}
  description={project.description}
  ogImage={`/og/projects/${slug}.png`}
>
  <Fragment slot="head">
    {
      rendered?.hasEmbeds && (
        <script
          is:inline
          src="https://embed.zenn.studio/js/listen-embed-event.js"
        ></script>
      )
    }
  </Fragment>

  <div class="shell docs-layout">
    <aside class="docs-sidebar">
      <a class="back-link" href="/#projects">← つくったもの一覧</a>
      <p class="eyebrow">PROJECTS</p>

      <nav aria-label="つくったもの一覧">
        {
          projects.map((item) => (
            <a
              href={projectDetailHref(item)}
              aria-current={item.id === project.id ? 'page' : undefined}
            >
              {item.name.split(/\s+[-—–]\s+/)[0]?.trim() || item.name}
            </a>
          ))
        }
      </nav>
    </aside>

    <article class="docs-article">
      <div class="mb-4 lg:hidden">
        <a class="back-link" href="/#projects">← つくったもの一覧へ戻る</a>
      </div>

      {
        projects.length > 1 && (
          <details class="mobile-toc mb-6 lg:hidden">
            <summary>他のつくったもの（全{projects.length}件）</summary>
            <nav aria-label="つくったもの一覧（モバイル）">
              {projects.map((item) => (
                <a
                  href={projectDetailHref(item)}
                  aria-current={item.id === project.id ? 'page' : undefined}
                >
                  {item.name.split(/\s+[-—–]\s+/)[0]?.trim() || item.name}
                </a>
              ))}
            </nav>
          </details>
        )
      }

      <header class="docs-title">
        <p class="eyebrow">{project.category} / OVERVIEW</p>
        <h1>{project.name}</h1>
        <p class="lead whitespace-pre-line">{project.description}</p>

        {
          project.tags.length > 0 && (
            <div class="tags mt-4">
              {project.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          )
        }

        <div class="mt-6 flex flex-wrap gap-3">
          {
            project.url && (
              <a
                class="button primary"
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                サイトを開く <span aria-hidden="true">↗</span>
              </a>
            )
          }
          {
            project.repoUrl && (
              <a
                class="button outline"
                href={project.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub リポジトリ <span aria-hidden="true">↗</span>
              </a>
            )
          }
          {
            project.librarySlug && (
              <a
                class={`button ${project.url ? 'outline' : 'primary'}`}
                href={docHref(project.librarySlug)}
              >
                導入ガイドを読む <span aria-hidden="true">→</span>
              </a>
            )
          }
          {validMarkdown && <CopyMarkdownButton markdown={copyMarkdown} />}
        </div>
      </header>

      <div class="project-detail-visual mb-10 overflow-hidden rounded-2xl border border-line">
        <ProjectVisual project={project} large />
      </div>

      {
        rendered && rendered.headings.length > 0 && (
          <details class="mobile-toc">
            <summary>このページの内容</summary>
            <nav aria-label="ページ内の目次">
              {rendered.headings.map((heading) => (
                <a
                  href={'#' + encodeURIComponent(heading.id)}
                  data-level={heading.level}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </details>
        )
      }

      {
        rendered ? (
          <div class="znc doc-content mb-12" set:html={rendered.html} />
        ) : (
          <section class="project-section mb-12">
            <h2>プロジェクト概要</h2>
            <p class="whitespace-pre-line">{project.description}</p>
            {project.librarySlug && (
              <p class="mt-4">
                インストール方法や詳しい使い方は{' '}
                <a class="text-link" href={docHref(project.librarySlug)}>
                  導入ガイド →
                </a>{' '}
                をご覧ください。
              </p>
            )}
          </section>
        )
      }

      {
        relatedArticles.length > 0 && (
          <section class="project-section">
            <h2>関連する技術記事</h2>
            <div class="mt-4 grid gap-3">
              {relatedArticles.map((article) => (
                <a class="related-article-card" href={article.url}>
                  <div>
                    <time datetime={article.date}>
                      {formatDate(article.date)}
                    </time>
                    <strong>{article.title}</strong>
                  </div>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </article>

    <aside class="desktop-toc">
      {
        rendered && rendered.headings.length > 0 && (
          <nav aria-label="ページ内の目次">
            <p class="eyebrow">このページの内容</p>
            {rendered.headings.map((heading) => (
              <a
                href={'#' + encodeURIComponent(heading.id)}
                data-level={heading.level}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        )
      }
    </aside>
  </div>

  {
    rendered?.hasMath && (
      <script>
        if (document.querySelector('embed-katex')) {
          import('zenn-embed-elements');
        }
      </script>
    )
  }
</Base>
