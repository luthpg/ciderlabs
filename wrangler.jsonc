{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ciderlabs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["enable_nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
